<?xml version="1.0"?>
<ruleset name="Said Dunn Site Enhancements">
	<description>WordPress coding standards for the installable plugin source.</description>

	<config name="installed_paths" value="vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils,vendor/wp-coding-standards/wpcs"/>
	<config name="minimum_supported_wp_version" value="6.0"/>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="p"/>

	<file>said-dunn-site-enhancements</file>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
</ruleset>
